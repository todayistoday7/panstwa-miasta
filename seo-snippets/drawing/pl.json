ize:13px;font-weight:700;text-decoration:none;\">🇩🇪 Zeichnen & Raten</a><a href=\"/skissa-och-gissa\" style=\"color:var(--muted);font-size:13px;font-weight:700;text-decoration:none;\">🇸🇪 Skissa & Gissa</a><a href=\"/jak-grac/szkicuj-i-zgaduj\" style=\"color:var(--muted);font-size:13px;font-weight:700;text-decoration:none;\">📖 Zasady gry</a><a href=\"/gry\" style=\"color:var(--muted);font-size:13px;font-weight:700;text-decoration:none;\">🎮 Wszystkie gry</a>\n  </div>\n</div>\n<script src=\"/socket.io/socket.io.js\"></script>\n<script src=\"/js/shared.js\"></script>\n<script src=\"/js/drawing-client.js\"></script>\n<script>\n// Override setUiLang on SEO pages — navigate to language-specific URL\n// instead of translating in place (keeps URL consistent with language)\nwindow._seoLangUrls = {'pl':'/szkicuj-i-zgaduj', 'en':'/sketch-and-guess', 'de':'/zeichnen-und-raten', 'sv':'/skissa-och-gissa'};\n(function() {{\n  var _origSetUiLang = null;\n  function _seoSetUiLang(code) {{\n    var url = window._seoLangUrls[code];\n    if (url) {{\n      window.location.href = url;\n    }} else if (_origSetUiLang) {{\n      _origSetUiLang(code);\n    }}\n  }}\n  // Wait for game client to define setUiLang, then override it\n  var _attempts = 0;\n  function _tryOverride() {{\n    if (typeof setUiLang === 'function' && setUiLang !== _seoSetUiLang) {{\n      _origSetUiLang = setUiLang;\n      setUiLang = _seoSetUiLang;\n      window.setUiLang = _seoSetUiLang;\n      // Rebuild lang bar so buttons use new setUiLang\n      if (typeof buildLangBar === 'function') buildLangBar();\n    }} else if (_attempts++ < 20) {{\n      setTimeout(_tryOverride, 100);\n    }}\n  }}\n  _tryOverride();\n}})();\n</script>"
